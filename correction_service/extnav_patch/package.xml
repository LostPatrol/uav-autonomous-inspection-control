<!-- 生产 extnav_bridge 元数据模板；缺少 correction_interfaces 时源码仍 identity 透传。 -->
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>extnav_bridge</name>
  <version>1.0.0</version>
  <description>支持原子平面修正的 Odin 至 MAVROS 外部导航桥。</description>
  <maintainer email="2823931730@qq.com">北京航空航天大学项目组</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <depend>correction_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>python3-numpy</depend>
  <depend>rclpy</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

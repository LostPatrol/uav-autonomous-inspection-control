# 安装器会替换这两个占位符；现场文件后续由运维人员维护且不会被覆盖。
# Copyright (c) 2026 北京航空航天大学
# SPDX-License-Identifier: MulanPSL-2.0
ONBOARD_ROS_DISTRO=ONBOARD_ROS_DISTRO_VALUE
ONBOARD_WORKSPACE=ONBOARD_WORKSPACE_PATH

# 存在多个串口候选时，只有核对飞机接线后才能指定飞控；优先使用稳定的 by-id 路径。
# MAVROS_FCU_DEVICE=/dev/serial/by-id/<已确认飞控设备>

# 只有确认实际部署工作区后，才固定包含对应包的 overlay。
# ODIN_OVERLAY_SETUP=/home/<用户>/<Odin工作区>/install/setup.bash
# EXTNAV_OVERLAY_SETUP=/home/<用户>/<extnav工作区>/install/setup.bash

# 域 0 与独立启动的 MAVROS、Odin 和 extnav 默认值一致。只有四个机载进程和地面站在启动前
# 同时加载相同配置时才能改用其他域；修改已经运行的 shell 不能迁移现有节点。
ROS_DOMAIN_ID=0

# 启动器在 Humble 使用该变量，在 Jazzy 自动改用下面的 discovery range。
ROS_LOCALHOST_ONLY=0

# Jazzy 正式机载链使用同网段发现；Humble 启动时会自动忽略该变量。
ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET

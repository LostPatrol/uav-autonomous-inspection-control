<!-- 独立于 GUI 生命周期运行的机载任务管理与 100 Hz PD+DOB 控制包。 -->
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>onboard_control</name>
  <version>1.0.0</version>
  <description>机载命令仲裁、航点执行、故障保护与 C++ PD+DOB 控制。</description>
  <maintainer email="2823931730@qq.com">北京航空航天大学项目组</maintainer>
  <license>MulanPSL-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>eigen</depend>
  <depend>eigen3_cmake_module</depend>
  <depend>geographic_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>guided_interfaces</depend>
  <depend>mavros_msgs</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>

  <!-- control.launch.py runtime imports; required by both Humble and Jazzy deployments. -->
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

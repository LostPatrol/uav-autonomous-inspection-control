# GUI 在仅限本机发现的域 231 中创建本地仿真；操作者连接实机时，在域 0 重建 ROS 上下文。
export ROS_DOMAIN_ID=0
export ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET

# 若组播发现不稳定，可填写已经人工确认的无人机伴随计算机地址。
# export ROS_STATIC_PEERS=192.168.1.10

# 上位机 WebSocket 通讯插件；默认随地面站启动并尝试连接。
export UPSTREAM_WS_URL=ws://127.0.0.1:8581/ws
export UPSTREAM_CLIENT_NO=UAV01001
export UPSTREAM_WS_AUTO_CONNECT=1
# 待机 01 的机库近原点判定和巡检降落后延时。
export UPSTREAM_HANGAR_X_TOLERANCE_METERS=1.0
export UPSTREAM_HANGAR_Y_TOLERANCE_METERS=1.0
export UPSTREAM_HANGAR_Z_TOLERANCE_METERS=0.5
export UPSTREAM_INSPECTION_STANDBY_DELAY_SECONDS=60.0
